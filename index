<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Picture Words – לומדים אנגלית</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Secular+One&family=Heebo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#e9e5ff;--ink:#1b1340;--card:#ffffff;--line:#1b1340;--mu:#5b5486;--on:#1b1340;--c:#b9a8ff;
  --disp:"Secular One","Arial Rounded MT Bold",Arial,sans-serif;
  --body:"Heebo",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#14102b;--ink:#f1eeff;--card:#231b4a;--line:#f1eeff;--mu:#a9a2d6}}
:root[data-theme="dark"]{--paper:#14102b;--ink:#f1eeff;--card:#231b4a;--line:#f1eeff;--mu:#a9a2d6}
[data-c="Nature"]{--c:#4be3a0}[data-c="Science"]{--c:#ffd84a}[data-c="Travel"]{--c:#58cdf5}[data-c="Everyday"]{--c:#ff7d9c}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0}
body{background:var(--paper);color:var(--ink);font-family:var(--body);padding-bottom:96px;min-height:100%}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--paper);z-index:10}
.wrap{max-width:560px;margin:0 auto;padding:18px 16px}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.logo{font-family:var(--disp);font-size:1.7rem;margin:0;direction:ltr;transform:rotate(-2deg)}
.logo span{background:var(--c);padding:0 .25em;border:3px solid var(--line);border-radius:10px;display:inline-block;transform:rotate(3deg)}
.hint{color:var(--mu);font-size:.9rem;margin:0}
.cats{display:flex;gap:8px;overflow-x:auto;padding:4px 4px 12px;margin:0 -4px}
.chip{flex:none;font:600 .95rem var(--body);color:var(--ink);background:var(--card);border:3px solid var(--line);border-radius:999px;padding:6px 14px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--c);color:var(--on);box-shadow:3px 3px 0 var(--line)}
.sticker{background:var(--c);color:var(--on);border:3px solid var(--line);border-radius:32px 32px 32px 10px;box-shadow:7px 7px 0 var(--line);padding:22px 18px 20px;text-align:center;animation:pop .28s ease-out}
@keyframes pop{from{transform:scale(.94) rotate(-1.5deg)}to{transform:none}}
.count{font-weight:800;font-size:.9rem;margin:0 0 10px}
.disc{width:min(56vw,230px);aspect-ratio:1;margin:0 auto 14px;border-radius:50%;background:#fff;border:3px solid var(--on);display:grid;place-items:center;font-size:clamp(4.5rem,24vw,7.5rem);line-height:1}
.en{font-family:var(--disp);font-size:clamp(2.4rem,12vw,3.6rem);line-height:1;direction:ltr;margin:0 0 6px;word-break:break-word}
.he{font-size:1.35rem;font-weight:800;min-height:1.9rem;margin:4px 0 8px}
.ex{direction:ltr;font-size:1.05rem;line-height:1.45;margin:0 auto 16px;max-width:30ch}
.row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.btn{font:800 1rem var(--body);color:var(--ink);background:var(--card);border:3px solid var(--line);border-radius:14px;padding:10px 16px;cursor:pointer;box-shadow:3px 3px 0 var(--line);min-height:44px}
.sticker .btn{color:#1b1340;background:#fff;border-color:#1b1340;box-shadow:3px 3px 0 #1b1340}
.btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--line)}
.btn.go{background:var(--ink);color:var(--paper)}
.nav .btn.go,.sticker .btn.go{background:#1b1340;color:#fff}
.stepper{display:flex;gap:10px;margin-top:18px}.stepper .btn{flex:1}
button:focus-visible{outline:4px solid var(--ink);outline-offset:3px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.col{display:grid;gap:10px;align-content:start}
.tile{font:800 1.15rem var(--body);direction:ltr;min-height:64px;background:var(--card);color:var(--ink);border:3px solid var(--line);border-radius:16px;cursor:pointer;box-shadow:3px 3px 0 var(--line)}
.tile.pic{font-size:2.5rem;line-height:1}
.tile.sel{background:var(--c);color:var(--on);transform:translate(-2px,-2px) rotate(-2deg);box-shadow:5px 5px 0 var(--line)}
.tile.ok{background:var(--c);color:var(--on);box-shadow:none;transform:none;opacity:.55;pointer-events:none}
.tile.bad{background:#ff4d4d;color:#fff;animation:shake .3s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.msg{min-height:1.8em;font-weight:800;font-size:1.1rem;margin:12px 0 0;text-align:center}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px}
.opts .tile{background:#fff;color:#1b1340;border-color:#1b1340;box-shadow:3px 3px 0 #1b1340}
.opts .tile.ok{background:#1b1340;color:#fff;opacity:1}
.big{font-family:var(--disp);font-size:4.5rem;direction:ltr;line-height:1;margin:6px 0}
.nav{position:fixed;inset:auto 0 0;z-index:5;display:flex;gap:8px;justify-content:center;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:3px solid var(--line)}
.nav .tab{flex:1;max-width:170px;font:800 1rem var(--body);color:var(--ink);background:var(--card);border:3px solid var(--line);border-radius:14px;padding:10px 4px;cursor:pointer;min-height:48px}
.nav .tab[aria-pressed="true"]{background:var(--c);color:var(--on);box-shadow:3px 3px 0 var(--line)}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<div class="wrap" id="app">
  <header>
    <h1 class="logo">Picture <span>Words</span></h1>
    <p class="hint">אוצר מילים · רמה B</p>
  </header>
  <div class="cats" id="cats" role="group" aria-label="קטגוריה"></div>
  <main id="main"></main>
</div>
<nav class="nav" id="nav" aria-label="מצבי לימוד"></nav>
<script>
const W=[
["Nature","volcano","🌋","הר געש","The volcano erupted last night."],
["Nature","tornado","🌪️","טורנדו","A tornado destroyed several houses."],
["Nature","rainbow","🌈","קשת","We saw a rainbow after the rain."],
["Nature","island","🏝️","אי","They spent a week on a tropical island."],
["Nature","desert","🏜️","מדבר","It is extremely hot in the desert."],
["Nature","lightning","⚡","ברק","Lightning struck the old tree."],
["Science","telescope","🔭","טלסקופ","He studies the stars with a telescope."],
["Science","microscope","🔬","מיקרוסקופ","Bacteria are visible under a microscope."],
["Science","magnet","🧲","מגנט","A magnet attracts metal objects."],
["Science","battery","🔋","סוללה","My phone battery is almost empty."],
["Science","satellite","🛰️","לוויין","The satellite orbits the Earth."],
["Science","thermometer","🌡️","מד חום","The nurse checked my temperature with a thermometer."],
["Travel","passport","🛂","דרכון","Do not forget your passport at the airport."],
["Travel","suitcase","🧳","מזוודה","She packed her suitcase for the trip."],
["Travel","compass","🧭","מצפן","A compass shows you which way is north."],
["Travel","anchor","⚓","עוגן","The crew dropped the anchor near the shore."],
["Travel","bridge","🌉","גשר","We drove across the bridge at sunset."],
["Travel","tent","⛺","אוהל","They set up a tent next to the lake."],
["Everyday","umbrella","☂️","מטריה","Take an umbrella, it might rain."],
["Everyday","scissors","✂️","מספריים","Pass me the scissors, please."],
["Everyday","hammer","🔨","פטיש","He used a hammer to fix the fence."],
["Everyday","key","🔑","מפתח","I lost the key to my bike."],
["Everyday","trophy","🏆","גביע","Our team won the trophy this year."],
["Everyday","candle","🕯️","נר","She lit a candle on the table."]
];
const CATS=[["All","הכול"],["Nature","טבע"],["Science","מדע"],["Travel","מסעות"],["Everyday","יומיום"]];
const TABS=[["learn","לומדים"],["match","מחברים"],["quiz","חידון"]];
let mode="learn",cat="All",idx=0,show=false;
const $=id=>document.getElementById(id);
const pool=()=>W.filter(w=>cat==="All"||w[0]===cat);
const shuf=a=>[...a].sort(()=>Math.random()-.5);
const colorOf=()=>cat==="All"?"":cat;
function say(t){try{const u=new SpeechSynthesisUtterance(t);u.lang="en-US";u.rate=.85;speechSynthesis.cancel();speechSynthesis.speak(u)}catch(e){}}
function chrome(){
  document.documentElement.dataset.c=colorOf();
  $("cats").innerHTML=CATS.map(c=>`<button class="chip" data-c="${c[0]==="All"?"":c[0]}" aria-pressed="${cat===c[0]}" onclick="cat='${c[0]}';idx=0;show=false;run()">${c[1]}</button>`).join("");
  $("nav").innerHTML=TABS.map(t=>`<button class="tab" aria-pressed="${mode===t[0]}" onclick="mode='${t[0]}';idx=0;show=false;run()">${t[1]}</button>`).join("");
}
function run(){chrome();({learn,match,quiz:startQuiz})[mode]()}
function learn(){
  const p=pool(),n=p.length,w=p[idx%n];
  $("main").innerHTML=`<section class="sticker" data-c="${w[0]}">
  <p class="count">${idx%n+1} מתוך ${n}</p>
  <div class="disc" aria-hidden="true">${w[2]}</div>
  <h2 class="en">${w[1]}</h2>
  <p class="he">${show?w[3]:""}</p>
  <p class="ex">${w[4]}</p>
  <div class="row">
    <button class="btn" onclick="say('${w[1]}')">השמע מילה</button>
    <button class="btn" onclick="say(document.querySelector('.ex').textContent)">השמע משפט</button>
    <button class="btn" onclick="show=!show;learn()">${show?"הסתר תרגום":"הצג תרגום"}</button>
  </div></section>
  <div class="stepper"><button class="btn" onclick="idx=(idx-1+${n})%${n};show=false;learn()">הקודם</button><button class="btn go" onclick="idx++;show=false;learn()">הבא</button></div>`;
}
let sel=null,left=0;
function match(){
  const p=shuf(pool()).slice(0,6);left=p.length;sel=null;
  const t=(w,k)=>`<button class="tile ${k==="p"?"pic":""}" data-c="${w[0]}" data-w="${w[1]}" data-k="${k}" onclick="pick(this)" ${k==="p"?`aria-label="תמונה"`:""}>${k==="p"?w[2]:w[1]}</button>`;
  $("main").innerHTML=`<p class="hint" style="margin-bottom:12px">בוחרים תמונה ואז את המילה שמתאימה לה.</p>
  <div class="cols"><div class="col">${shuf(p).map(w=>t(w,"p")).join("")}</div><div class="col">${shuf(p).map(w=>t(w,"w")).join("")}</div></div>
  <p class="msg" id="msg" aria-live="polite"></p>
  <div class="row"><button class="btn" onclick="match()">משחק חדש</button></div>`;
}
function pick(b){
  if(!sel){sel=b;b.classList.add("sel");return}
  if(sel===b){b.classList.remove("sel");sel=null;return}
  if(sel.dataset.k===b.dataset.k){sel.classList.remove("sel");sel=b;b.classList.add("sel");return}
  const a=sel;a.classList.remove("sel");sel=null;
  if(a.dataset.w===b.dataset.w){a.classList.add("ok");b.classList.add("ok");say(b.dataset.w);
    if(--left===0)$("msg").textContent="כל הכבוד, חיברתם הכול!";}
  else{a.classList.add("bad");b.classList.add("bad");setTimeout(()=>{a.classList.remove("bad");b.classList.remove("bad")},450)}
}
let Q=[],qi=0,sc=0;
function startQuiz(){Q=shuf(pool()).slice(0,10);qi=0;sc=0;ask()}
function ask(){
  if(qi>=Q.length){
    const r=sc>=Q.length*.8?"מעולה, אתם שולטים במילים":sc>=Q.length*.5?"יפה, עוד סיבוב ותשפרו":"כדאי לחזור על המילים במצב לימוד";
    $("main").innerHTML=`<section class="sticker"><p class="count">סיימתם</p><div class="big">${sc}/${Q.length}</div><p class="he">${r}</p><div class="row"><button class="btn" onclick="startQuiz()">חידון חדש</button><button class="btn" onclick="mode='learn';idx=0;run()">חזרה ללימוד</button></div></section>`;return}
  const w=Q[qi],o=shuf([w,...shuf(W.filter(x=>x!==w)).slice(0,3)]);
  $("main").innerHTML=`<section class="sticker" data-c="${w[0]}">
  <p class="count">שאלה ${qi+1} מתוך ${Q.length} · נכון: ${sc}</p>
  <div class="disc" aria-hidden="true">${w[2]}</div>
  <p class="he" style="margin-bottom:12px">איך אומרים את זה באנגלית?</p>
  <div class="opts">${o.map(x=>`<button class="tile" onclick="ans(this,${x===w})">${x[1]}</button>`).join("")}</div>
  <p class="msg" id="msg" aria-live="polite"></p></section>`;
}
function ans(b,ok){
  document.querySelectorAll(".opts .tile").forEach(x=>x.style.pointerEvents="none");
  const w=Q[qi];
  if(ok){b.classList.add("ok");sc++;$("msg").textContent="נכון! "+w[3]}
  else{b.classList.add("bad");$("msg").textContent="התשובה: "+w[1]+" ("+w[3]+")"}
  say(w[1]);qi++;setTimeout(ask,1600);
}
run();
</script>
</body>
</html>
